#!/bin/bash
set -e 

[[ "$(uname -s)" -ne "Darwin" ]] && (echo "Error: This will not run on not OSX"; exit 1) 
# osx package signing in a dedicated mac or your local.
# you need the following environment variables set
# ACCESS_KEY - aws/s3 access key
# SECRET_KEY - aws/s3 secret key

# you will also need s3cmd
# curl http://softlayer-sng.dl.sourceforge.net/project/s3tools/s3cmd/1.5.0-rc1/s3cmd-1.5.0-rc1.tar.gz | tar -C /tmp -xz
# cd /tmp/s3cmd-1.5.0-rc1 && sudo python setup.py install

# You'll need the Developer ID Installer certificate CA generated by Apple in your Keychain.

# Prepare the environment
for TOOL in s3cmd productsign spctl; do
        [[ ! -f $(which $TOOL) ]] && (echo "Error: $TOOL not found please install $TOOL"; exit 1)
done

TIMESTAMP=$(date +"%Y%d%m%H%M%S")
OSX_BUCKET=osx.nitrous.io
UNSIGNED_PKGNAME=nitro-latest-unsigned-darwin_amd64.pkg
SIGNED_PKGNAME=nitro-latest-signed-darwin_amd64.pkg
ARTIFACT_DIR=/tmp/nitro-osx-pkg/$TIMESTAMP
UNSIGNED_PKGDIR=$ARTIFACT_DIR/unsigned
SIGNED_PKGDIR=$ARTIFACT_DIR/signed
UNSIGNED_PKG=$UNSIGNED_PKGDIR/$UNSIGNED_PKGNAME
SIGNED_PKG=$SIGNED_PKGDIR/$SIGNED_PKGNAME

for DIR in $ARTIFACT_DIR $UNSIGNED_PKGDIR $SIGNED_PKGDIR; do
        [[ ! -d $DIR ]] && mkdir -pv $DIR
done

# Download the unsigned
s3cmd --access_key=$ACCESS_KEY --secret_key=$SECRET_KEY get s3://${OSX_BUCKET}/${UNSIGNED_PKGNAME} ${UNSIGNED_PKG}

# Sign
productsign --sign "Developer ID Installer: Jihoon Kim" "$UNSIGNED_PKG" "$SIGNED_PKG"  

# Check and upload back to s3
ACCEPTED=$(spctl -av --type install $SIGNED_PKG 2>&1 | grep -c "accepted")

if [[ "$ACCEPTED" -ne "0" ]]; then
        s3cmd --access_key=$ACCESS_KEY --secret_key=$SECRET_KEY --acl-public put $SIGNED_PKG s3://${OSX_BUCKET}/${SIGNED_PKGNAME}
        # clean-up
        rm -rfv $ARTIFACT_DIR
else
        echo "Error is package signing, please check."
        exit 1
fi
