#!/usr/bin/env bash
# we get primary version from `VERSION` file
set -x
set -e
export APP=${1:?"app is required"}
export VERSION=${2:?"version is required"}
export NITRO_API_URL=${3:-http://127.0.0.1:3333}
export BUILD_DIR=./build

rm -f "$BUILD_DIR/$APP"
mkdir -p "$BUILD_DIR"

if [[ ! -z "$CA_CERT" ]]; then
  CA_CERT=$CA_CERT goop exec go install \
    -ldflags="-X main.version ${VERSION} -X github.com/nitrous-io/dedicated/nitro/command.DefaultAPIURL ${NITRO_API_URL} -X github.com/nitrous-io/dedicated/nitro/consts.CACertPEM \"${CA_CERT}\"" -x -v ./...
else
  goop exec go install -ldflags="-X main.version ${VERSION} -X github.com/nitrous-io/dedicated/nitro/command.DefaultAPIURL ${NITRO_API_URL}" -x -v ./...
fi

goop exec bash -c 'mv $GOBIN/$APP $BUILD_DIR/$APP'
echo "Binary built successfully: $BUILD_DIR/$APP"
